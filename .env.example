# Copy to .env (or set these in docker-compose / the Unraid template).
# Everything except CONFIG_DIR and DATABASE_URL can also be changed on the Settings page.

# Where the database, cached dialogue and posters live
CONFIG_DIR=/config
# DATABASE_URL=postgresql+psycopg://user:pass@host/wherewerewe

# Address of this app as seen from your phone (used for links in notifications)
PUBLIC_URL=http://192.168.1.100:8765

# Plex (https by IP needs VERIFY_SSL=false; the certificate is issued for *.plex.direct)
PLEX_URL=https://192.168.1.100:32400
PLEX_TOKEN=
VERIFY_SSL=false
# Plex's path to the media = the same folder inside this container (';' separates pairs)
MEDIA_PATH_MAP=/data/media=/data/media

# Tautulli
TAUTULLI_URL=http://192.168.1.100:8181
TAUTULLI_API_KEY=

# LLM: any OpenAI-compatible endpoint. Ollama is detected and uses its native API.
LLM_BASE_URL=http://192.168.1.100:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=
LLM_CONTEXT_TOKENS=16384

# Whisper fallback for episodes without subtitles (needs the GPU reservation)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# Login: setting an admin password turns it on. Plex sign-in then works for everyone with
# access to your Plex server (the owner is an admin; others only see their own shows).
ADMIN_PASSWORD=
PLEX_LOGIN=true

# Optional. A free TMDB key adds each episode's synopsis and credited cast, and gives
# Up Next related shows, keywords and creators.
TMDB_API_KEY=
# Optional: Add to Sonarr for Up Next picks that aren't in Plex
SONARR_URL=
SONARR_API_KEY=
# dialogue (model summarizes subtitles) or synopsis (TMDB/Plex synopsis only; no GPU)
SUMMARY_SOURCE=dialogue
NTFY_URL=
DISCORD_WEBHOOK_URL=
WEBHOOK_SECRET=
